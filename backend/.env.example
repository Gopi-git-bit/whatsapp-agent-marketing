# ==============================================================================
# Rajesh Transport - Logistics Platform Backend Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-me-in-production-use-a-secure-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

# Database Settings
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=db.sqlite3
# For production PostgreSQL setup, uncomment and configure:
# DJANGO_DB_ENGINE=django.db.backends.postgresql
# DJANGO_DB_NAME=backend
# DJANGO_DB_USER=backend
# DJANGO_DB_PASSWORD=backend
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Celery & Redis configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CHANNELS_REDIS_URL=redis://localhost:6379/2

# Sentry DSN (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# SLA Threshold Settings
SLA_THRESHOLD_SECONDS=0.5

# ==============================================================================
# External Service Integrations
# ==============================================================================

# Airtable CRM / Dashboard Sync Settings
AIRTABLE_ACCESS_TOKEN=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_USERS_TABLE=Users
AIRTABLE_ORDERS_TABLE=Orders

# WhatsApp Notification Gateway Settings
# Supported Providers: twilio, whapi, generic
WHATSAPP_PROVIDER=generic
WHATSAPP_API_URL=https://api.example.com/whatsapp/send
WHATSAPP_API_KEY=your_whatsapp_gateway_key_here
WHATSAPP_SENDER_NUMBER=+919876543210

# Twilio Specific Settings (if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
